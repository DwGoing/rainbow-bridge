# Rainbow Bridge mainnet profile (example)
# Copy to .env and replace placeholders.

SOLVER_USE_CHAIN_POLLING=true
SOLVER_SRC_CHAIN_KIND=evm
SOLVER_SRC_RPC_URL=https://mainnet.infura.io/v3/<YOUR_KEY>
SOLVER_SRC_ENDPOINT_ADDRESS=0x0000000000000000000000000000000000000000
SOLVER_SRC_PACKAGE_ID=0x0
SOLVER_SRC_STATE_OBJECT_ID=0x0
SOLVER_SRC_MODULE=bridge
SOLVER_DST_CHAIN_KIND=sui
SOLVER_DST_RPC_URL=https://fullnode.mainnet.sui.io:443
SOLVER_FROM_BLOCK=0
SOLVER_TO_BLOCK=0

VALIDATOR_USE_CHAIN_POLLING=true
VALIDATOR_SRC_CHAIN_KIND=evm
VALIDATOR_SRC_RPC_URL=https://mainnet.infura.io/v3/<YOUR_KEY>
VALIDATOR_SRC_ENDPOINT_ADDRESS=0x0000000000000000000000000000000000000000
VALIDATOR_SRC_PACKAGE_ID=0x0
VALIDATOR_SRC_STATE_OBJECT_ID=0x0
VALIDATOR_SRC_MODULE=bridge
VALIDATOR_DST_CHAIN_KIND=sui
VALIDATOR_DST_RPC_URL=https://fullnode.mainnet.sui.io:443
VALIDATOR_FROM_BLOCK=0
VALIDATOR_TO_BLOCK=0

VALIDATOR_TX_MODE=off
VALIDATOR_TX_PRIVATE_KEY=
VALIDATOR_TX_WAIT_RECEIPT=false
VALIDATOR_TX_RECEIPT_TIMEOUT_SECS=120
VALIDATOR_CHALLENGE_WINDOW_SECS=600
VALIDATOR_SUI_CLI_BIN=sui
VALIDATOR_SUI_SENDER=
VALIDATOR_SUI_GAS_BUDGET=10000000

FLOW_EVENT_LOG_PATH=data/flow-events.jsonl
EXPLORER_BIND=127.0.0.1:8080
