# ----------------------------
# Rust services (solver / validator)
# ----------------------------
SOLVER_USE_CHAIN_POLLING=true
SOLVER_SRC_CHAINS_JSON='[{"name":"evm-local","chain_kind":"evm","rpc_url":"http://127.0.0.1:8545","endpoint_address":"0x...","chain_id":31337},{"name":"sui-local","chain_kind":"sui","rpc_url":"http://127.0.0.1:9000","package_id":"0x...","state_object_id":"0x...","module":"bridge","chain_id":101}]'
SOLVER_DST_CHAINS_JSON='[{"name":"sui-local","chain_kind":"sui","rpc_url":"http://127.0.0.1:9000","package_id":"0x...","state_object_id":"0x...","module":"bridge","chain_id":101},{"name":"evm-local","chain_kind":"evm","rpc_url":"http://127.0.0.1:8545","endpoint_address":"0x...","chain_id":31337}]'
SOLVER_FROM_BLOCK=0
SOLVER_TO_BLOCK=0
SOLVER_POLL_INTERVAL_SECS=3

VALIDATOR_USE_CHAIN_POLLING=true
VALIDATOR_SRC_CHAINS_JSON='[{"name":"evm-local","chain_kind":"evm","rpc_url":"http://127.0.0.1:8545","endpoint_address":"0x...","chain_id":31337},{"name":"sui-local","chain_kind":"sui","rpc_url":"http://127.0.0.1:9000","package_id":"0x...","state_object_id":"0x...","module":"bridge","chain_id":101}]'
VALIDATOR_DST_CHAINS_JSON='[{"name":"sui-local","chain_kind":"sui","rpc_url":"http://127.0.0.1:9000","package_id":"0x...","state_object_id":"0x...","module":"bridge","chain_id":101},{"name":"evm-local","chain_kind":"evm","rpc_url":"http://127.0.0.1:8545","endpoint_address":"0x...","chain_id":31337}]'
VALIDATOR_FROM_BLOCK=0
VALIDATOR_TO_BLOCK=0
VALIDATOR_POLL_INTERVAL_SECS=3
# Optional offline injection for multi-source polling fallback
# VALIDATOR_POLLED_PROPOSALS_BY_SOURCE_JSON={"evm-local":[{"intent_hash":"0x...","validator":"0x...","solver":"0x...","amount_out":1,"tx_hash":"0x...","block_number":1,"timestamp":1}]}

# validator tx execution mode: off | dry-run | send
VALIDATOR_TX_MODE=off
VALIDATOR_TX_PRIVATE_KEY=
VALIDATOR_TX_WAIT_RECEIPT=false
VALIDATOR_TX_RECEIPT_TIMEOUT_SECS=120
VALIDATOR_CHALLENGE_WINDOW_SECS=600
VALIDATOR_SUI_CLI_BIN=sui
VALIDATOR_SUI_SENDER=
VALIDATOR_SUI_GAS_BUDGET=10000000

# shared event log for explorer
FLOW_EVENT_LOG_PATH=data/flow-events.jsonl
EXPLORER_BIND=127.0.0.1:8080

# ----------------------------
# Contract deployment
# ----------------------------
DEPLOY_EVM_RPC_URL=
DEPLOYER_PRIVATE_KEY=
DEPLOY_OWNER=
DEPLOY_CHAIN_ID=

DEPLOY_SUI_PACKAGE_PATH=contracts/sui
DEPLOY_SUI_GAS_BUDGET=100000000
DEPLOY_SUI_SENDER=
DEPLOY_SUI_SKIP_FETCH=true
DEPLOY_SUI_DRY_RUN=false
DEPLOY_SUI_BUILD_ENV=
DEPLOY_SUI_PUBFILE_PATH=

# ----------------------------
# Contracts
# ----------------------------
# Foundry uses root foundry.toml and contracts/evm libs.
# Sui uses contracts/sui/Move.toml.
